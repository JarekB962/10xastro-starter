---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { getSelectedProject } from "@/lib/services/projects";

const supabase = Astro.locals.supabase;
const selected = supabase ? await getSelectedProject(supabase) : null;
const project = selected?.ok ? selected.data : null;
const loadError = supabase && selected && !selected.ok ? "Nie udało się wczytać wybranego projektu." : null;
---

<Layout title="Szkielet roboczy — Plan projektu (WBS)">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-2xl">
      <Topbar />
      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        {loadError && (
          <p class="mb-4 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300">
            {loadError}
          </p>
        )}
        {project ? (
          <>
            <p class="text-sm text-blue-100/60">Wybrany projekt</p>
            <h1 class="mt-1 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold break-words text-transparent">
              {project.name}
            </h1>
            {project.description && <p class="mt-3 break-words text-blue-100/80">{project.description}</p>}
          </>
        ) : (
          <>
            <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
              Nie wybrano projektu
            </h1>
            <p class="mt-3 text-blue-100/80">Wybierz projekt z listy albo dodaj nowy, aby zacząć pracę.</p>
          </>
        )}
        <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
          {project && (
            <a href="/specialties" class="text-purple-300 hover:underline">
              Specjalności projektu
            </a>
          )}
          <a href="/projects" class="text-purple-300 hover:underline">
            Wróć do listy projektów
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
