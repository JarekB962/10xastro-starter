---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { SUPABASE_NOT_CONFIGURED } from "@/lib/services/projects";
import { getSpecialtyUsage } from "@/lib/services/specialties";
import { parseSpecialtyId } from "@/lib/validation/specialty";

const supabase = Astro.locals.supabase;
// Nieistniejąca i cudza specjalność wyglądają tak samo: 404. Bez klienta Supabase: 503 z komunikatem o konfiguracji,
// a błąd bazy przy odczycie: 500 (nie udajemy, że specjalności nie ma).
const id = parseSpecialtyId(Astro.params.id);
const result = supabase && id ? await getSpecialtyUsage(supabase, id) : null;
const specialty = result?.ok ? result.data.specialty : null;
const usedBy = result?.ok ? result.data.tasks : [];
const loadFailed = result !== null && !result.ok && result.error !== "not_found";
const notFoundMessage = !supabase
  ? SUPABASE_NOT_CONFIGURED
  : loadFailed
    ? "Nie udało się wczytać specjalności"
    : "Nie znaleziono specjalności";
if (!specialty) Astro.response.status = !supabase ? 503 : loadFailed ? 500 : 404;

const error = Astro.url.searchParams.get("error");
---

<Layout title="Usuwanie specjalności — Plan projektu (WBS)">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-md">
      <Topbar />
      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent">
          {specialty
            ? usedBy.length === 0
              ? "Usunąć specjalność?"
              : "Nie można usunąć specjalności"
            : notFoundMessage}
        </h1>
        {error && (
          <p class="mb-4 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300">{error}</p>
        )}
        {specialty && usedBy.length === 0 && (
          <>
            <p class="text-center text-blue-100/80">
              Specjalność <span class="font-semibold break-words text-white">{specialty.name}</span> zostanie usunięta
              na stałe. Tej operacji nie można cofnąć.
            </p>
            <form
              method="POST"
              action={`/api/specialties/${specialty.id}/delete`}
              class="mt-6 flex items-center justify-center gap-4"
            >
              <button
                type="submit"
                class="rounded-lg bg-red-600 px-4 py-2 text-sm font-medium transition-colors hover:bg-red-500"
              >
                Usuń specjalność
              </button>
              <a href="/specialties" class="text-sm text-purple-300 hover:underline">
                Anuluj
              </a>
            </form>
          </>
        )}
        {specialty && usedBy.length > 0 && (
          <>
            <p class="text-center text-blue-100/80">Aby było to możliwe, zmień specjalność poniższych zadań:</p>
            <ul class="mt-4 space-y-2">
              {usedBy.map((task) => (
                <li class="flex items-start justify-between gap-4 rounded-xl border border-white/10 bg-white/5 p-3">
                  <span class="min-w-0 text-sm break-words">
                    <span class="mr-2 text-purple-300">{task.number}.</span>
                    {task.name}
                  </span>
                  <a
                    href={`/tasks/${task.id}/edit`}
                    class="shrink-0 text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
                  >
                    Edytuj
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
        {!(specialty && usedBy.length === 0) && (
          <p class="mt-4 text-center text-sm text-blue-100/60">
            <a href="/specialties" class="text-purple-300 hover:underline">
              Wróć do listy specjalności
            </a>
          </p>
        )}
      </div>
    </div>
  </div>
</Layout>
