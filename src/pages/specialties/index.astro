---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import SpecialtyForm from "@/components/specialties/SpecialtyForm";
import { SUPABASE_NOT_CONFIGURED, getSelectedProject } from "@/lib/services/projects";
import { listSpecialties } from "@/lib/services/specialties";

const supabase = Astro.locals.supabase;
const selected = supabase ? await getSelectedProject(supabase) : null;
const project = selected?.ok ? selected.data : null;
const specialties = supabase && project ? await listSpecialties(supabase, project.id) : null;

const loadError = !supabase
  ? SUPABASE_NOT_CONFIGURED
  : selected && !selected.ok
    ? "Nie udało się wczytać wybranego projektu."
    : specialties && !specialties.ok
      ? "Nie udało się wczytać specjalności."
      : null;
const error = Astro.url.searchParams.get("error") ?? loadError;
const initial = { name: Astro.url.searchParams.get("specialty_name") ?? "" };
---

<Layout title="Specjalności — Plan projektu (WBS)">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-2xl">
      <Topbar />
      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Specjalności
        </h1>
        {project && <p class="mt-1 mb-6 text-sm break-words text-blue-100/60">Projekt: {project.name}</p>}
        {!project && <div class="mb-6" />}

        {error && (
          <p class="mb-4 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300">{error}</p>
        )}

        {supabase && selected?.ok && !project && (
          <div>
            <p class="text-blue-100/70">Nie wybrano projektu.</p>
            <a href="/projects" class="mt-4 inline-block text-sm text-purple-300 hover:underline">
              Przejdź do listy projektów
            </a>
          </div>
        )}

        {project && (
          <>
            <div class="mb-6">
              <SpecialtyForm action="/api/specialties" initial={initial} submitLabel="Dodaj specjalność" client:load />
            </div>

            {specialties?.ok && specialties.data.length === 0 && (
              <p class="text-blue-100/70">Ten projekt nie ma jeszcze specjalności. Dodaj pierwszą.</p>
            )}

            {specialties?.ok && specialties.data.length > 0 && (
              <ul class="space-y-3">
                {specialties.data.map((specialty) => (
                  <li class="rounded-xl border border-white/10 bg-white/5 p-4">
                    <div class="flex items-center justify-between gap-4">
                      <h2 class="min-w-0 truncate font-semibold">{specialty.name}</h2>
                      <a
                        href={`/specialties/${specialty.id}/edit`}
                        class="shrink-0 text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
                      >
                        Edytuj
                      </a>
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </>
        )}
      </div>
    </div>
  </div>
</Layout>
