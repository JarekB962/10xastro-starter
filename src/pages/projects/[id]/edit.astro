---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import ProjectForm from "@/components/projects/ProjectForm";
import { SUPABASE_NOT_CONFIGURED, getProject } from "@/lib/services/projects";
import { parseProjectId } from "@/lib/validation/project";

const supabase = Astro.locals.supabase;
// Nieistniejący i cudzy projekt wyglądają tak samo: 404. Bez klienta Supabase: 503 z komunikatem o konfiguracji,
// a błąd bazy przy odczycie: 500 (nie udajemy, że projektu nie ma).
const id = parseProjectId(Astro.params.id);
const result = supabase && id ? await getProject(supabase, id) : null;
const project = result?.ok ? result.data : null;
const loadFailed = result !== null && !result.ok && result.error !== "not_found";
const notFoundMessage = !supabase
  ? SUPABASE_NOT_CONFIGURED
  : loadFailed
    ? "Nie udało się wczytać projektu"
    : "Nie znaleziono projektu";
if (!project) Astro.response.status = !supabase ? 503 : loadFailed ? 500 : 404;

const params = Astro.url.searchParams;
const error = params.get("error");
// Po błędzie serwera formularz wraca z tym, co użytkownik wpisał; bez błędu z zapisanymi danymi.
const entered = error ? params : null;
const initial = {
  name: entered?.get("project_name") ?? project?.name ?? "",
  description: entered?.get("project_description") ?? project?.description ?? "",
};
---

<Layout title="Edycja projektu — Plan projektu (WBS)">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-md">
      <Topbar />
      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent">
          {project ? "Edycja projektu" : notFoundMessage}
        </h1>
        {project && (
          <ProjectForm
            action={`/api/projects/${project.id}`}
            initial={initial}
            serverError={error}
            submitLabel="Zapisz zmiany"
            client:load
          />
        )}
        <p class="mt-4 text-center text-sm text-blue-100/60">
          <a href="/projects" class="text-purple-300 hover:underline">
            Wróć do listy projektów
          </a>
        </p>
      </div>
    </div>
  </div>
</Layout>
