---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import ProjectForm from "@/components/projects/ProjectForm";

const params = Astro.url.searchParams;
const error = params.get("error");
const initial = { name: params.get("project_name") ?? "", description: params.get("project_description") ?? "" };
---

<Layout title="Nowy projekt — Plan projektu (WBS)">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-md">
      <Topbar />
      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent">
          Nowy projekt
        </h1>
        <ProjectForm
          action="/api/projects"
          initial={initial}
          serverError={error}
          submitLabel="Dodaj projekt"
          client:load
        />
        <p class="mt-4 text-center text-sm text-blue-100/60">
          <a href="/projects" class="text-purple-300 hover:underline">
            Wróć do listy projektów
          </a>
        </p>
      </div>
    </div>
  </div>
</Layout>
